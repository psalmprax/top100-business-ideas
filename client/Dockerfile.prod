# Multi-stage production Dockerfile for AlphaAI Unified Frontend & Gateway
FROM node:20-bookworm-slim AS builder

WORKDIR /app

# Install pnpm (consistent version)
RUN npm install -g pnpm@10.15.1

# Copy package files from root
COPY package.json pnpm-lock.yaml ./
COPY patches ./patches

# Install dependencies (frozen-lockfile for production stability)
RUN pnpm install --frozen-lockfile

# Copy source code
COPY client/ ./client/
COPY shared/ ./shared/
COPY server/ ./server/
COPY vite.config.ts ./vite.config.ts
COPY tsconfig.json ./tsconfig.json
COPY tsconfig.node.json ./tsconfig.node.json
COPY components.json ./components.json

# Build the frontend and the gateway server
RUN pnpm run build

# Final production image
FROM node:20-bookworm-slim

WORKDIR /app

# Set environment
ENV NODE_ENV=production
ENV PORT=7000

# Copy necessary files for prod install
COPY --from=builder /app/package.json /app/pnpm-lock.yaml ./
COPY --from=builder /app/patches ./patches
COPY --from=builder /app/dist ./dist

# Install only production dependencies
RUN npm install -g pnpm@10.15.1 && pnpm install --prod --frozen-lockfile

EXPOSE 7000

# Start the unified gateway server
CMD ["node", "dist/index.js"]
