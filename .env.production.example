# AlphaHecta Sentinel - Production Environment Template
# SECURITY: Never commit actual .env files. Copy this to .env and populate with secrets.

# --- INFRASTRUCTURE ---
NODE_ENV=production
CORS_ORIGIN=http://149.104.110.122
JWT_SECRET=             # Generate with: openssl rand -base64 32
ADMIN_SECRET=           # Global panic word / reset secret
SECRET_KEY=              # Python backend secret

# --- DATABASE ---
DB_USER=postgres
DB_PASSWORD=            # Use a strong unique password
DB_NAME=alphaai

# --- EXTERNAL SERVICES ---
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLIC_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=live

# --- GOOGLE OIDC ---
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
SESSION_SECRET_KEY=     # Used for OAuth state
